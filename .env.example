# Production OS example only. NEVER put real values into this file or git.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/productionos
DIRECT_URL=
# 32+ random bytes, base64. Used to sign session cookies' CSRF binding.
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Owner-authorised READ-ONLY Airtable migration (schema.bases:read + data.records:read only).
AIRTABLE_PAT=
# Object storage: "local" (dev only, ./storage) or "s3" (any S3-compatible provider, e.g. R2, S3)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Outbound comms are disabled until configured AND explicitly enabled.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=
ENABLE_REAL_EMAIL=false
SIGNING_PROVIDER=
SIGNING_API_KEY=
ENABLE_REAL_SIGNATURE_REQUESTS=false
# Bearer secret for the job runner endpoint (Vercel Cron → /api/jobs/run)
JOB_SECRET=
