# ─── Bang On OS self-hosted configuration ───  (./install.sh writes this for you)
DOMAIN=os.example.com            # public hostname; Caddy gets an HTTPS certificate for it automatically
APP_PORT=3000                    # local port (127.0.0.1 only) — Caddy serves 80/443 publicly
POSTGRES_PASSWORD=               # generated
SECRET_ENCRYPTION_KEY=           # generated: openssl rand -base64 32 (encrypts stored credentials)
CRON_SECRET=                     # generated: protects the background job endpoint

# Files: "db" keeps attachments in Postgres (simplest). Use the MinIO profile for large media:
STORAGE_PROVIDER=db
# STORAGE_PROVIDER=s3
# STORAGE_ENDPOINT=http://minio:9000
# STORAGE_BUCKET=bangon-files
# STORAGE_ACCESS_KEY_ID=bangon
# STORAGE_SECRET_ACCESS_KEY=      # generated

# ─── AI: choose one ───
# 1) Private (nothing leaves your servers): run the Ollama profile or point at your own model server
# AI_PROVIDER=local
# LOCAL_AI_BASE_URL=http://ollama:11434/v1
# LOCAL_AI_MODEL=qwen2.5:7b      # bigger = better (qwen2.5:14b/32b, llama3.1:70b) — needs tool calling
# 2) Claude (Anthropic API)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# 3) No AI
# AI_PROVIDER=off

# ─── Optional integrations ───
# MAIL_PROVIDER=resend  MAIL_API_KEY=  MAIL_FROM=  ENABLE_REAL_EMAIL=true
# SLACK_WEBHOOK_URL=
# COMPOSIO_API_KEY=
