{
  "name": "bang-on-production-os",
  "version": "0.1.0",
  "private": true,
  "description": "Bang On Production OS — unified film, TV, documentary, commercial and studio production management platform.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "jobs:run": "tsx scripts/run-jobs.ts",
    "import:airtable": "tsx scripts/import-airtable.ts",
    "backup": "bash scripts/backup.sh",
    "restore": "bash scripts/restore.sh",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@aws-sdk/client-s3": "^3.1172.0",
    "@stylexjs/stylex": "^0.19.2",
    "drizzle-orm": "0.45.4",
    "exceljs": "^4.4.0",
    "jose": "^6.2.18",
    "lucide-react": "^1.76.0",
    "next": "15.5.29",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.16",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
